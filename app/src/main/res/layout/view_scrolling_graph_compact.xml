<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact layout: the value beside the graph rather than above it, for fields too short for a
    header row. The value is a real TextView so Karoo lays it out at an exact sp size, the same
    way its own numeric fields do; drawn into the bitmap instead, it was scaled along with the
    bitmap to fit a tile whose real height isn't knowable from ViewConfig, and rendered at
    different sizes from row to row.

    "monospace" resolves to Relative12-Regular.otf, the face Karoo's own numeric fields use.

    Both value slots exist so either side can be used without reassigning weights, which
    RemoteViews cannot do before API 31; the unused one is hidden, and a hidden view takes no
    space, leaving the graph and the remaining value to split the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/value_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="45"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="3dp"
        android:paddingEnd="0dp"
        android:textColor="@android:color/black"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/graph_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="55"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/value_end"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="45"
        android:fontFamily="monospace"
        android:gravity="top|end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="0dp"
        android:paddingEnd="3dp"
        android:textColor="@android:color/black"
        android:visibility="gone" />

</LinearLayout>
